# demo loads the local /catalog fixture. live makes a server-side GET request.
PRODUCTS_DATA_MODE=demo
# Cart actions are independent: demo simulates responses; live modifies a commerce cart.
CART_DATA_MODE=demo
# Optional in live mode: your existing checkout path or HTTPS URL. No checkout is implemented here.
CART_CHECKOUT_URL=
# Required in live mode. Include any deployment-specific path prefix.
COMMERCE_API_BASE_URL=
# /catalog is documented as public. No credentials are needed or included.
HOST=127.0.0.1
PORT=4321
