---
import type { ProductCardProps as Props } from './products.types';
const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<article class="product-card">
  <div class="product-image">
    {product.image ? (
      <img src={product.image.src} alt={product.image.alt}
        width={product.image.width} height={product.image.height} decoding="async" />
    ) : (
      <div class="image-placeholder" role="img" aria-label={`Image unavailable for ${product.title}`}>
        <span class="placeholder-mark" aria-hidden="true">Image</span>
        <span>Photography coming soon</span>
      </div>
    )}
    {product.stockLabel && <span class="stock-label">{product.stockLabel}</span>}
  </div>
  <Heading>{product.title}</Heading>
  <p class="product-price">
    <span><span class="sr-only">Current price: </span>{product.price}</span>
    {product.comparisonPrice && <del><span class="sr-only">Comparison price: </span>{product.comparisonPrice}</del>}
  </p>
</article>

<style>
  .product-card { min-width: 0; color: #202020; }
  .product-image { position: relative; aspect-ratio: 3 / 4; background: #f3f3f1; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .stock-label {
    position: absolute; top: 14px; right: 14px; padding: 7px 10px;
    background: #fff; color: #292929; font-size: 12px; line-height: 1.2;
  }
  h2, h3 { margin: 18px 0 8px; font-size: 16px; line-height: 1.45; font-weight: 500; overflow-wrap: anywhere; }
  .product-price { display: flex; flex-wrap: wrap; gap: 6px 12px; margin: 0; font-size: 14px; line-height: 1.5; }
  .product-price > * { white-space: nowrap; }
  del { color: #737373; font-weight: 400; }
  .image-placeholder {
    display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center;
    height: 100%; padding: 24px; text-align: center; color: #666; font-size: 13px;
  }
  .placeholder-mark { font-size: 28px; color: #777; font-weight: 300; letter-spacing: -1px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
