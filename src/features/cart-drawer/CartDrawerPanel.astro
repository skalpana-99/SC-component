---
import CartItem from '../cart-item/CartItem.astro';
import type { CartDrawerPanelProps as Props } from './cart-drawer.types';
const { view } = Astro.props;
---
<div class="cart-view" data-cart-view data-item-count={view.itemCount}>
  {view.items.length === 0 ? <div class="empty-basket"><h3>Your basket is empty</h3><p>Add an item to get started.</p></div> : <>
    <div class="drawer-items" data-drawer-items>
      {view.items.map(item => <CartItem item={item} removalMode="external" managed />)}
    </div>
    <footer class="basket-footer">
      {view.totals && <dl class="basket-totals" aria-label="Basket totals">
        <div><dt>Net total</dt><dd>{view.totals.net}</dd></div>
        <div><dt>Tax</dt><dd>{view.totals.tax}</dd></div>
        <div class="grand-total"><dt>Total</dt><dd>{view.totals.total}</dd></div>
      </dl>}
      {view.checkoutHref ? <a class="checkout-link" data-checkout href={view.checkoutHref}>Checkout</a>
        : <p class="checkout-unavailable">Checkout is unavailable here.</p>}
    </footer>
  </>}
</div>
<style>
  .cart-view { container-type: inline-size; }
  .empty-basket { padding: 48px 0; }
  .empty-basket h3 { margin: 0 0 12px; font-weight: 500; font-size: 21px; }
  .empty-basket p { color: #666; font-size: 14px; line-height: 1.6; }
  .basket-footer { padding: 28px 0 12px; }
  .basket-totals { margin: 0 0 28px; font-size: 14px; line-height: 1.6; }
  .basket-totals > div { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 12px; }
  dt, dd { margin: 0; }
  dd { white-space: nowrap; }
  .grand-total { padding-top: 16px; border-top: 1px solid #e7e7e7; font-size: 18px; font-weight: 500; }
  .checkout-link { display: block; padding: 14px 24px; min-height: 48px; text-align: center; background: #202020; color: #fff; text-decoration: none; font-size: 14px; line-height: 1.5; }
  .checkout-link:hover { background: #3b3b3b; }
  .checkout-unavailable { color: #666; font-size: 14px; line-height: 1.6; }
</style>
